# Bootstrap ONLY (DESIGN.md: "everything in db"). All behavioral config —
# model, tenant, context thresholds, memory, the tool header/catalog split, MCP
# servers, self-config grants — lives in the `settings` table, written by
# `pinky config set`. The agent's only write path is the validated
# `settings_set` tool, and only for keys a human allow-lists via
# `selfConfig.allowedKeys` (DESIGN.md P8) — never `mcp.*`, which is immutable.

# ---------------------------------------------------------------------------
# Postgres: TWO urls, because row-level security needs two privilege levels
# (DESIGN.md §5.1). docker compose provides both endpoints by default.
#
#   DATABASE_ADMIN_URL  used for MIGRATIONS ONLY. Needs DDL + CREATE ROLE, so
#                       it is the superuser. `pinky migrate` uses it, and so do
#                       `smoke`/`prompt`/`memory`/`mcp`/`tools`/`headless` for
#                       the auto-migrate they do at startup — on a short-lived
#                       connection they close again before opening the app
#                       pool. Defaults to DATABASE_URL when unset.
#   DATABASE_URL        used by everything else (runtime, config, memory).
#                       Should be the unprivileged `pinky_app` role: RLS is
#                       bypassed unconditionally by superusers, so connecting
#                       as `postgres` makes the memories policy decorative.
#                       It cannot run migrations — that is the point of the
#                       split, and why the two urls are not interchangeable.
#
# `pinky_app` is created by migration 0003_rls.sql (LOGIN, NOSUPERUSER,
# NOBYPASSRLS) with the dev password `pinky`, matching docker-compose.yml.
# THAT PASSWORD IS NOT A SECRET. In production, after the first migrate:
#     psql "$DATABASE_ADMIN_URL" -c "alter role pinky_app password '<generated>'"
# then put the new password in DATABASE_URL. Re-running migrations never
# overwrites an existing role's password.
# ---------------------------------------------------------------------------
DATABASE_ADMIN_URL=postgres://postgres:pinky@localhost:5544/pinky

# Default below is the superuser, so a fresh clone migrates and runs with zero
# setup — but tenant isolation is NOT enforced on that connection: RLS is
# bypassed and a query missing `where tenant_id = ...` will see every tenant.
# Once `pinky migrate` has run at least once, switch to the app role:
#   DATABASE_URL=postgres://pinky_app:pinky@localhost:5544/pinky
DATABASE_URL=postgres://postgres:pinky@localhost:5544/pinky

# Optional second dev database WITH pgvector, for the vector half of hybrid
# recall (DESIGN.md §5.4). The default alpine image has no pgvector, so
# `memories.embedding` never exists there and recall runs FTS-only — which is
# a supported mode, not a failure. Point both urls at 5545 to exercise vectors:
# DATABASE_URL=postgres://postgres:pinky@localhost:5545/pinky   # bun run db:up:vector (pgvector)

# Integration tests (packages/core/test/integration) are skipped unless this
# is set; they need the live database on 5544.
# PINKY_INTEGRATION=1

# LLM API secrets (model + behavioral config come from the settings table).
# OpenRouter is the universal route: one key reaches moonshot/zai/gemini/etc.
# Set model via: pinky config set model '"openrouter/moonshotai/kimi-k2"'
#
# The SAME keys pay for EMBEDDINGS (DESIGN.md §5.5): when
# `memory.embeddingModel` is `openai/…` the embedder uses OPENAI_API_KEY /
# OPENAI_BASE_URL, and `openrouter/…` uses the OpenRouter pair. Leaving the
# matching key blank is survivable — the process warns once and recall runs on
# the FTS voice alone — but to say so on purpose:
#     pinky config set memory.embeddingModel '"none"'
# which also stops retained memories from being embedded at all.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM transport hardening — not agent behavior, so env rather than `settings`.
# Read by createProvider()/transportOptionsFromEnv(); a malformed value throws
# at startup, not at the first model call. Values below are the defaults.
# Retries per request on 429/5xx/timeouts (0 disables retrying).
PINKY_LLM_MAX_RETRIES=3
# Whole-request budget per attempt in ms, streaming included.
PINKY_LLM_TIMEOUT_MS=120000
# Ask OpenAI-compatible streams for token usage; set false for endpoints that
# reject stream_options.include_usage (turns are then journaled without usage).
PINKY_LLM_INCLUDE_USAGE=true
# Send `prompt_cache_key` (the thread's identity) on OpenAI-compatible routes so
# one thread keeps landing on one prompt-cache shard. The ONLY knob here without
# a fixed default: the field is OpenAI-NATIVE, so createProvider() turns it on
# for `openai/` against real api.openai.com and off for `openrouter/` and for any
# `openai/` with an OPENAI_BASE_URL override (vLLM, llama.cpp, LM Studio, Azure
# reject an unknown top-level field on every request). Setting it below wins on
# every route; a non-boolean throws at startup. It is a routing hint — losing it
# costs hit rate, never correctness.
# PINKY_LLM_PROMPT_CACHE_KEY=true
# Lifetime stamped on every Anthropic cache_control breakpoint: 5m or 1h. A 1h
# write costs ~2x an input token instead of ~1.25x, which pays off when this
# agent's start-to-start wake gaps land in the 5-60 minute band.
PINKY_ANTHROPIC_CACHE_TTL=5m
# Embeddings have their own, shorter budget: recall is on the wake path, so a
# hung embeddings endpoint degrades to FTS-only quickly instead of stalling
# every run. Dimensions are pinned to the memories.embedding column (1536,
# Matryoshka-truncated for the text-embedding-3-* models); set 0 to omit the
# `dimensions` field for endpoints that reject it (ada-002, local clones).
PINKY_EMBED_TIMEOUT_MS=15000
PINKY_EMBED_MAX_RETRIES=2
PINKY_EMBED_DIMENSIONS=1536

# Agent-to-agent addressing
PINKY_NODE_ID=local
# Comma-separated peer nodes for cross-machine A2A: node2=https://node2.example.com,node3=https://10.0.0.5:3000
PINKY_PEERS=
# HMAC secret shared by all nodes that may exchange A2A messages. REQUIRED once
# PINKY_PEERS names a peer — a process that would talk to a peer refuses to
# start without it, and with no secret at all POST /a2a/deliver answers 503
# rather than accepting every unsigned envelope (an HMAC over an empty key
# verifies anything). With no peers, nothing needs it.
A2A_SECRET=

# Port the A2A relay listens on.
PORT=3000

# ---------------------------------------------------------------------------
# MCP servers have NO variable here on purpose: a server is a setting
# (`pinky config set mcp.servers.<name> '<json>'`), never a file or an env var.
# What DOES belong here are the credentials those entries reference — an
# `env`/`headers` value written "${GITHUB_TOKEN}" is resolved from this
# process's environment at connect time, so the settings row holds the name and
# never the secret. Add whatever your servers name, e.g.:
#
#   GITHUB_TOKEN=
