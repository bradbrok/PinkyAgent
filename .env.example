# Bootstrap ONLY (DESIGN.md: "everything in db"). All behavioral config —
# model, tenant, context thresholds, reply gate — lives in the `settings`
# table and is written by `pinky config set`. The agent has no write path.

# ---------------------------------------------------------------------------
# Postgres: TWO urls, because row-level security needs two privilege levels
# (DESIGN.md §5.1). docker compose provides both endpoints by default.
#
#   DATABASE_ADMIN_URL  used for MIGRATIONS ONLY. Needs DDL + CREATE ROLE, so
#                       it is the superuser. `pinky migrate` uses it, and so do
#                       `gateway`/`smoke`/`prompt` for the auto-migrate they do
#                       at startup — on a short-lived connection they close
#                       again before opening the app pool. Defaults to
#                       DATABASE_URL when unset.
#   DATABASE_URL        used by everything else (gateway, runtime, config).
#                       Should be the unprivileged `pinky_app` role: RLS is
#                       bypassed unconditionally by superusers, so connecting
#                       as `postgres` makes the memories policy decorative.
#                       It cannot run migrations — that is the point of the
#                       split, and why the two urls are not interchangeable.
#
# `pinky_app` is created by migration 0003_rls.sql (LOGIN, NOSUPERUSER,
# NOBYPASSRLS) with the dev password `pinky`, matching docker-compose.yml.
# THAT PASSWORD IS NOT A SECRET. In production, after the first migrate:
#     psql "$DATABASE_ADMIN_URL" -c "alter role pinky_app password '<generated>'"
# then put the new password in DATABASE_URL. Re-running migrations never
# overwrites an existing role's password.
# ---------------------------------------------------------------------------
DATABASE_ADMIN_URL=postgres://postgres:pinky@localhost:5544/pinky

# Default below is the superuser, so a fresh clone migrates and runs with zero
# setup — but tenant isolation is NOT enforced on that connection: RLS is
# bypassed and a query missing `where tenant_id = ...` will see every tenant.
# Once `pinky migrate` has run at least once, switch to the app role:
#   DATABASE_URL=postgres://pinky_app:pinky@localhost:5544/pinky
DATABASE_URL=postgres://postgres:pinky@localhost:5544/pinky

# Integration tests (packages/core/test/integration) are skipped unless this
# is set; they need the live database on 5544.
# PINKY_INTEGRATION=1

# LLM API secrets (model + behavioral config come from the settings table).
# OpenRouter is the universal route: one key reaches moonshot/zai/gemini/etc.
# Set model via: pinky config set model '"openrouter/moonshotai/kimi-k2"'
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM transport hardening — not agent behavior, so env rather than `settings`.
# Read by createProvider()/transportOptionsFromEnv(); a malformed value throws
# at startup, not at the first model call. Values below are the defaults.
# Retries per request on 429/5xx/timeouts (0 disables retrying).
PINKY_LLM_MAX_RETRIES=3
# Whole-request budget per attempt in ms, streaming included.
PINKY_LLM_TIMEOUT_MS=120000
# Ask OpenAI-compatible streams for token usage; set false for endpoints that
# reject stream_options.include_usage (turns are then journaled without usage).
PINKY_LLM_INCLUDE_USAGE=true

# Agent-to-agent addressing
PINKY_NODE_ID=local
# Comma-separated peer nodes for cross-machine A2A: node2=https://node2.example.com,node3=https://10.0.0.5:3000
PINKY_PEERS=
# HMAC secret shared by all nodes that may exchange A2A messages. REQUIRED once
# PINKY_PEERS names a peer — `pinky gateway` refuses to start without it, and
# with no secret at all POST /a2a/deliver answers 503 rather than accepting
# every unsigned envelope (an HMAC over an empty key verifies anything).
A2A_SECRET=

# Slack gateway. BOTH are required: `pinky gateway` refuses to start if either
# is empty, because an empty signing secret verifies every forged request. The
# bot token is also what auth.test resolves the bot user id from — without it
# mentions are never recognized, so the bot never engages in a channel.
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
PORT=3000
